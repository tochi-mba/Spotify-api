# This service holds NO Spotify credential. It asks keyring for the headers to
# attach, per user, per request. Point it at your keyring instance and give it
# the service token keyring issued for this service.
KEYRING_BASE_URL=http://127.0.0.1:8001
KEYRING_SERVICE_TOKEN=your-keyring-service-token-here

# --- Everything below is optional; defaults shown. ---

# Which keyring profile to use when a request does not name one.
# KEYRING_DEFAULT_PROFILE=personal
# KEYRING_TIMEOUT_SECONDS=5.0
# CREDENTIAL_CACHE_SKEW_SECONDS=60
# CREDENTIAL_CACHE_DEFAULT_TTL_SECONDS=300

# Upstream endpoint. Override only for sandboxes or tests.
# SPOTIFY_API_BASE_URL=https://api.spotify.com/v1

# Resilience
# REQUEST_TIMEOUT_SECONDS=10.0
# MAX_RETRIES=3
# RETRY_BACKOFF_BASE_SECONDS=0.2
# MAX_CONCURRENCY=8
# MAX_BATCH_SIZE=50

# Behaviour
# DEFAULT_MARKET=GB

# Observability
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# LOG_FORMAT=json
