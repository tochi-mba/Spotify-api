# Spotify Lookup API configuration. Every variable is prefixed SPOTIFY_API_.
#
# A SPOTIFY_API_-prefixed variable that matches no setting is a STARTUP ERROR, and so is any
# of the bare names this service read before it had a prefix (KEYRING_BASE_URL,
# DEFAULT_MARKET, SPOTIFY_API_BASE_URL, ...). The error names the variable that replaced each.
#
# This service holds NO Spotify credential. It verifies each caller's keyring token against
# keyring's published keys, then asks keyring for the headers to attach, per user, per request.

# --- Keyring: required -------------------------------------------------------
SPOTIFY_API_KEYRING_BASE_URL=http://127.0.0.1:8001
# This service's entry in keyring's KEYRING_SERVICE_TOKENS, under the name "spotify-api".
# At least 32 characters, the same rule keyring enforces. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SPOTIFY_API_KEYRING_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# --- Keyring: optional, defaults shown ---------------------------------------
# Must equal keyring's own KEYRING_ISSUER exactly, or every token is refused.
# SPOTIFY_API_KEYRING_ISSUER=http://127.0.0.1:8001
# The aud callers mint user tokens for: POST /v1/auth/service-token {"audience": "spotify-api"}.
# Keyring's internal endpoint requires it to equal this service's name in
# KEYRING_SERVICE_TOKENS, so change both or neither.
# SPOTIFY_API_KEYRING_AUDIENCE=spotify-api
# Which keyring profile to use when a request sends no X-Keyring-Profile header.
# SPOTIFY_API_KEYRING_DEFAULT_PROFILE=personal
# SPOTIFY_API_KEYRING_TIMEOUT_SECONDS=5.0
# SPOTIFY_API_JWKS_CACHE_SECONDS=3600
# The floor between key refetches an unknown key id may provoke. Not a tuning knob: without
# it, tokens carrying invented key ids become one request to keyring each.
# SPOTIFY_API_JWKS_MIN_REFETCH_SECONDS=60
# SPOTIFY_API_CREDENTIAL_CACHE_SKEW_SECONDS=60
# SPOTIFY_API_CREDENTIAL_CACHE_DEFAULT_TTL_SECONDS=300

# --- Upstream endpoint: override only for sandboxes or tests -----------------
# SPOTIFY_API_SPOTIFY_BASE_URL=https://api.spotify.com/v1

# --- Resilience ---------------------------------------------------------------
# SPOTIFY_API_REQUEST_TIMEOUT_SECONDS=10.0
# SPOTIFY_API_MAX_RETRIES=3
# SPOTIFY_API_RETRY_BACKOFF_BASE_SECONDS=0.2
# SPOTIFY_API_MAX_CONCURRENCY=8
# SPOTIFY_API_MAX_BATCH_SIZE=50

# --- Background jobs ----------------------------------------------------------
# SPOTIFY_API_CONFIRM_TIMEOUT_SECONDS=15.0
# SPOTIFY_API_CONFIRM_POLL_INTERVAL_SECONDS=0.5
# SPOTIFY_API_JOB_TTL_SECONDS=3600

# --- Behaviour ----------------------------------------------------------------
# SPOTIFY_API_DEFAULT_MARKET=GB

# --- Per-person settings (settings-api) --------------------------------------
# Unset (the default) keeps today's behaviour: everybody on this box shares the
# knobs above. Set both to read each person's `spotify` settings instead: default
# market, lookup batch cap, confirm timeout, and which profile they mean when they
# name none. A person may lower a ceiling, never raise it above this deployment.
# The token is this service's entry in settings-api's SETTINGS_API_SERVICES (32+
# characters); the grant's audience_prefix must be `spotify-api`. Never log it.
# SPOTIFY_API_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# SPOTIFY_API_SETTINGS_API_TOKEN=

# --- Serving ------------------------------------------------------------------
# SPOTIFY_API_HOST=127.0.0.1
# SPOTIFY_API_PORT=8007

# --- Observability ------------------------------------------------------------
# SPOTIFY_API_ENVIRONMENT=development
# SPOTIFY_API_LOG_LEVEL=INFO
# SPOTIFY_API_LOG_FORMAT=json
